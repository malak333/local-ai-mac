{
  "$schema": "https://opencode.ai/config.json",
  "model": "llama.cpp/qwen36-local",
  "enabled_providers": [
    "llama.cpp"
  ],
  "share": "disabled",
  "autoupdate": false,
  "snapshot": true,
  "compaction": {
    "auto": true,
    "prune": false,
    "reserved": 16384
  },
  "watcher": {
    "ignore": [
      ".git/**",
      "target/**",
      ".build/**",
      "DerivedData/**",
      "node_modules/**",
      "dist/**"
    ]
  },
  "agent": {
    "build": {
      "temperature": 0.1,
      "steps": 24
    }
  },
  "tools": {
    "skill": false,
    "task": false,
    "webfetch": true,
    "websearch": true,
    "lsp": false
  },
  "permission": "allow",
  "provider": {
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local M1 Pro",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "timeout": 900000
      },
      "models": {
        "qwen36-local": {
          "name": "Qwen3.6 35B-A3B IQ4_XS (local)",
          "limit": {
            "context": 262144,
            "output": 4096
          }
        }
      }
    }
  }
}
